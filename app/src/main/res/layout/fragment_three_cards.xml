<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/three_cards_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    tools:context=".ThreeCardsFragment">

    <!-- Cards container -->
    <FrameLayout
        android:id="@+id/cards_container"
        android:layout_width="0dp"
        android:layout_height="382dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp">

        <LinearLayout
            android:id="@+id/cards_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/card1"
                android:layout_width="120dp"
                android:layout_height="200dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/cover" />

            <ImageView
                android:id="@+id/card2"
                android:layout_width="120dp"
                android:layout_height="200dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/cover" />

            <ImageView
                android:id="@+id/card3"
                android:layout_width="120dp"
                android:layout_height="200dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/cover" />

        </LinearLayout>

    </FrameLayout>

    <!-- Interpret button -->
    <Button
        android:id="@+id/btn_interpret"
        style="@style/TarotButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/interpret"
        app:layout_constraintTop_toBottomOf="@id/cards_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>