<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title Style -->
    <style name="TarotTitle">
        <item name="android:textColor">#D1AB5B</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">@font/alegreya_extrabold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button Style -->
    <style name="TarotButton">
        <item name="android:backgroundTint">#E9B130</item>
        <item name="android:textColor">#000000</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColorLink">#D1C033</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>